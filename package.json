{
  "name": "image-crop-engine",
  "version": "0.1.0",
  "description": "A utility for cropping images based on viewport positions",
  "main": "lib/index.js",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "coveralls": "jest --coverage && coveralls < coverage/lcov.info",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "build": "babel src --out-dir lib",
    "prepublishOnly": "npm run lint:fix && npm run test && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "image",
    "crop",
    "engine",
    "transform",
    "viewport",
    "resize"
  ],
  "author": "Brendan Conrad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brencon/image-crop-engine.git"
  },
  "bugs": {
    "url": "https://github.com/brencon/image-crop-engine/issues"
  },
  "homepage": "https://github.com/brencon/image-crop-engine#readme",
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "coveralls": "^3.1.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
